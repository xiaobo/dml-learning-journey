fact:
  type: dataset
  table: FACT_SALES
  dimension: [id]
  columns:
    id:
    customer:
    region:
    amount:
    status:
    dt_date:
  measures:
    sales: SUM({amount})
    cnt: COUNT(1)
ratio: 'divide({sales}, {cnt})'
report:
  type: query
  columns:
    dimension: [bucket: '{cnt: {+d: customer}}']
    value: 'SUM({sales: {+d: customer}})'
